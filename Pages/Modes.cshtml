@page
@{
    ViewData["Title"] = "Modes";
    ViewData["Tag"] = "Learn";
    ViewData["Lead"] = "Neovim is modal: the same key does different things depending on the mode you are in.";
}

        <h2>The core modes</h2>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5"><div class="col"><div class="card nv-card h-100"><div class="card-body"><span class="badge badge-nv-blue mb-2">n</span><h3 class="h5 card-title">Normal</h3><p class="card-text">The default mode for navigation and commands. Press <kbd>Esc</kbd> to return here.</p></div></div></div><div class="col"><div class="card nv-card h-100"><div class="card-body"><span class="badge badge-nv-blue mb-2">i</span><h3 class="h5 card-title">Insert</h3><p class="card-text">Type text like in any editor. Enter with <kbd>i</kbd>, <kbd>a</kbd>, <kbd>o</kbd>.</p></div></div></div><div class="col"><div class="card nv-card h-100"><div class="card-body"><span class="badge badge-nv-blue mb-2">v</span><h3 class="h5 card-title">Visual</h3><p class="card-text">Select text with <kbd>v</kbd> (characters), <kbd>V</kbd> (lines) or <kbd>Ctrl-v</kbd> (blocks).</p></div></div></div><div class="col"><div class="card nv-card h-100"><div class="card-body"><span class="badge badge-nv-blue mb-2">c</span><h3 class="h5 card-title">Command-line</h3><p class="card-text">Press <kbd>:</kbd> to run Ex commands such as <code>:w</code> or <code>:q</code>.</p></div></div></div><div class="col"><div class="card nv-card h-100"><div class="card-body"><span class="badge badge-nv-blue mb-2">R</span><h3 class="h5 card-title">Replace</h3><p class="card-text">Press <kbd>R</kbd> to overwrite text as you type.</p></div></div></div><div class="col"><div class="card nv-card h-100"><div class="card-body"><span class="badge badge-nv-blue mb-2">t</span><h3 class="h5 card-title">Terminal</h3><p class="card-text">Run a shell inside a buffer with <code>:terminal</code>.</p></div></div></div></div>
        <h2>Mode reference</h2>
        <div class="table-responsive"><table class="table nv-table table-striped"><thead><tr><th>Mode</th><th>Enter with</th><th>Leave with</th><th>Statusline label</th></tr></thead><tbody><tr><td>Normal</td><td>Esc / Ctrl-[</td><td>&mdash;</td><td><span class="badge badge-nv-green">NORMAL</span></td></tr><tr><td>Insert</td><td><kbd>i</kbd> <kbd>a</kbd> <kbd>o</kbd></td><td><kbd>Esc</kbd></td><td><span class="badge badge-nv-blue">INSERT</span></td></tr><tr><td>Visual</td><td><kbd>v</kbd> <kbd>V</kbd></td><td><kbd>Esc</kbd></td><td><span class="badge badge-nv-magenta">VISUAL</span></td></tr><tr><td>Command</td><td><kbd>:</kbd></td><td><kbd>Enter</kbd> / <kbd>Esc</kbd></td><td><span class="badge badge-nv-yellow">COMMAND</span></td></tr><tr><td>Replace</td><td><kbd>R</kbd></td><td><kbd>Esc</kbd></td><td><span class="badge badge-nv-red">REPLACE</span></td></tr></tbody></table></div>


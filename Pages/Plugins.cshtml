@page
@{
    ViewData["Title"] = "Plugins";
    ViewData["Tag"] = "Ecosystem";
    ViewData["Lead"] = "The plugin ecosystem is what turns Neovim from an editor into a personal IDE.";
}

        <h2>Essential plugins</h2>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5"><div class="col"><div class="card nv-card h-100"><div class="card-body"><span class="badge badge-nv-blue mb-2">Manager</span><h3 class="h5 card-title">lazy.nvim</h3><p class="card-text">Plugin manager with lazy-loading and a lockfile.</p></div></div></div><div class="col"><div class="card nv-card h-100"><div class="card-body"><span class="badge badge-nv-blue mb-2">Navigation</span><h3 class="h5 card-title">telescope.nvim</h3><p class="card-text">Fuzzy finder for files, grep, buffers and more.</p></div></div></div><div class="col"><div class="card nv-card h-100"><div class="card-body"><span class="badge badge-nv-blue mb-2">Syntax</span><h3 class="h5 card-title">nvim-treesitter</h3><p class="card-text">Fast, accurate syntax highlighting and text objects.</p></div></div></div><div class="col"><div class="card nv-card h-100"><div class="card-body"><span class="badge badge-nv-blue mb-2">LSP</span><h3 class="h5 card-title">nvim-lspconfig</h3><p class="card-text">Ready-made configs for language servers.</p></div></div></div><div class="col"><div class="card nv-card h-100"><div class="card-body"><span class="badge badge-nv-blue mb-2">Tooling</span><h3 class="h5 card-title">mason.nvim</h3><p class="card-text">Install LSP servers, linters and formatters from inside Neovim.</p></div></div></div><div class="col"><div class="card nv-card h-100"><div class="card-body"><span class="badge badge-nv-blue mb-2">UX</span><h3 class="h5 card-title">which-key.nvim</h3><p class="card-text">Shows available keybindings in a popup as you type.</p></div></div></div><div class="col"><div class="card nv-card h-100"><div class="card-body"><span class="badge badge-nv-blue mb-2">Git</span><h3 class="h5 card-title">gitsigns.nvim</h3><p class="card-text">Git diff signs in the gutter, hunk actions and blame.</p></div></div></div><div class="col"><div class="card nv-card h-100"><div class="card-body"><span class="badge badge-nv-blue mb-2">Completion</span><h3 class="h5 card-title">blink.cmp</h3><p class="card-text">Fast autocompletion engine (alternative: nvim-cmp).</p></div></div></div><div class="col"><div class="card nv-card h-100"><div class="card-body"><span class="badge badge-nv-blue mb-2">UI</span><h3 class="h5 card-title">lualine.nvim</h3><p class="card-text">Configurable, fast statusline written in Lua.</p></div></div></div><div class="col"><div class="card nv-card h-100"><div class="card-body"><span class="badge badge-nv-blue mb-2">Files</span><h3 class="h5 card-title">oil.nvim</h3><p class="card-text">Edit your filesystem like a normal buffer.</p></div></div></div></div>
        <h2>At a glance</h2>
        <div class="table-responsive"><table class="table nv-table table-striped"><thead><tr><th>Plugin</th><th>Category</th><th>Purpose</th></tr></thead><tbody><tr><td><code>lazy.nvim</code></td><td><span class="badge badge-nv-green">Manager</span></td><td>Plugin manager with lazy-loading and a lockfile.</td></tr><tr><td><code>telescope.nvim</code></td><td><span class="badge badge-nv-blue">Navigation</span></td><td>Fuzzy finder for files, grep, buffers and more.</td></tr><tr><td><code>nvim-treesitter</code></td><td><span class="badge badge-nv-magenta">Syntax</span></td><td>Fast, accurate syntax highlighting and text objects.</td></tr><tr><td><code>nvim-lspconfig</code></td><td><span class="badge badge-nv-cyan">LSP</span></td><td>Ready-made configs for language servers.</td></tr><tr><td><code>mason.nvim</code></td><td><span class="badge badge-nv-yellow">Tooling</span></td><td>Install LSP servers, linters and formatters from inside Neovim.</td></tr><tr><td><code>which-key.nvim</code></td><td><span class="badge badge-nv-red">UX</span></td><td>Shows available keybindings in a popup as you type.</td></tr><tr><td><code>gitsigns.nvim</code></td><td><span class="badge badge-nv-green">Git</span></td><td>Git diff signs in the gutter, hunk actions and blame.</td></tr><tr><td><code>blink.cmp</code></td><td><span class="badge badge-nv-blue">Completion</span></td><td>Fast autocompletion engine (alternative: nvim-cmp).</td></tr><tr><td><code>lualine.nvim</code></td><td><span class="badge badge-nv-magenta">UI</span></td><td>Configurable, fast statusline written in Lua.</td></tr><tr><td><code>oil.nvim</code></td><td><span class="badge badge-nv-yellow">Files</span></td><td>Edit your filesystem like a normal buffer.</td></tr></tbody></table></div>
        <h2>Declaring plugins with lazy.nvim</h2>
        <pre class="code-block" data-lang="lua"><code>require("lazy").setup({
  { "nvim-telescope/telescope.nvim", dependencies = { "nvim-lua/plenary.nvim" } },
  { "nvim-treesitter/nvim-treesitter", build = ":TSUpdate" },
  { "folke/which-key.nvim", event = "VeryLazy" },
})</code></pre>


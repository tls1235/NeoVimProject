@page
@model NeoVimProject.Pages.PasswordRecoverModel
@{
    ViewData["Title"] = "Password Recovery";
    ViewData["Tag"] = "Account";
    ViewData["Lead"] = "Answer your two recovery questions to reset your password.";
}

        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <form method="post" class="form-card">
                    <div asp-validation-summary="All" class="text-danger small mb-2"></div>
                    <div class="row g-3">
                        <div class="col-12"><label class="form-label" for="Username">Username</label><input class="form-control" id="Username" name="Username" type="text" placeholder="your_username"  required /></div>
                        <div class="col-12"><label class="form-label">Recovery question 1</label><select class="form-select" name="Question1" required><option value="">Choose a question...</option><option value="1">What was the name of your first pet?</option><option value="2">What is your mother&#x27;s maiden name?</option><option value="3">What city were you born in?</option><option value="4">What was your first school?</option><option value="5">What is your favourite editor?</option></select></div>
                        <div class="col-12"><label class="form-label">Answer 1</label><input class="form-control" name="Answer1" type="text" required /></div>
                        <div class="col-12"><label class="form-label">Recovery question 2</label><select class="form-select" name="Question2" required><option value="">Choose a question...</option><option value="1">What was the name of your first pet?</option><option value="2">What is your mother&#x27;s maiden name?</option><option value="3">What city were you born in?</option><option value="4">What was your first school?</option><option value="5">What is your favourite editor?</option></select></div>
                        <div class="col-12"><label class="form-label">Answer 2</label><input class="form-control" name="Answer2" type="text" required /></div>
                        <div class="col-12 d-grid"><button type="submit" class="btn btn-nv">Submit</button></div>
                    </div>
                    <hr />
                    <a class="btn btn-nv-outline w-100" asp-page="/Login">&larr; Back to Login</a>
                </form>
            </div>
        </div>


@page
@{
    ViewData["Title"] = "Distributions";
    ViewData["Tag"] = "Ecosystem";
    ViewData["Lead"] = "Pre-configured setups that give you an IDE-like Neovim out of the box.";
}

        <h2>Popular starting points</h2>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5"><div class="col"><div class="card nv-card h-100"><div class="card-body"><span class="badge badge-nv-blue mb-2">Beginner friendly</span><h3 class="h5 card-title">LazyVim</h3><p class="card-text">Opinionated setup built on lazy.nvim with sensible defaults and easy extras.</p></div></div></div><div class="col"><div class="card nv-card h-100"><div class="card-body"><span class="badge badge-nv-blue mb-2">Fast</span><h3 class="h5 card-title">NvChad</h3><p class="card-text">Blazing-fast start-up and a polished UI with its own theme system.</p></div></div></div><div class="col"><div class="card nv-card h-100"><div class="card-body"><span class="badge badge-nv-blue mb-2">Feature rich</span><h3 class="h5 card-title">AstroNvim</h3><p class="card-text">Feature-rich, community-driven configuration with a plugin ecosystem of its own.</p></div></div></div><div class="col"><div class="card nv-card h-100"><div class="card-body"><span class="badge badge-nv-blue mb-2">Learn by reading</span><h3 class="h5 card-title">Kickstart.nvim</h3><p class="card-text">A single, heavily commented starter file meant to be read and modified.</p></div></div></div><div class="col"><div class="card nv-card h-100"><div class="card-body"><span class="badge badge-nv-blue mb-2">Legacy</span><h3 class="h5 card-title">LunarVim</h3><p class="card-text">An IDE layer for Neovim; check the project status before adopting.</p></div></div></div></div>
        <h2>Comparison</h2>
        <div class="table-responsive"><table class="table nv-table table-striped"><thead><tr><th>Distro</th><th>Learning curve</th><th>Customisation</th><th>Best for</th></tr></thead><tbody><tr><td>LazyVim</td><td><span class="badge badge-nv-green">Easy</span></td><td>High</td><td>Getting productive quickly</td></tr><tr><td>NvChad</td><td><span class="badge badge-nv-green">Easy</span></td><td>Medium</td><td>Performance and looks</td></tr><tr><td>AstroNvim</td><td><span class="badge badge-nv-yellow">Medium</span></td><td>High</td><td>Full IDE feature set</td></tr><tr><td>Kickstart.nvim</td><td><span class="badge badge-nv-yellow">Medium</span></td><td>Total</td><td>Understanding your own config</td></tr><tr><td>LunarVim</td><td><span class="badge badge-nv-yellow">Medium</span></td><td>Medium</td><td>Existing users</td></tr></tbody></table></div>


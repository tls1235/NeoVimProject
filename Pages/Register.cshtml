@page
@model NeoVimProject.Pages.RegisterModel
@{
  ViewData["Title"] = "Register";
  ViewData["Tag"] = "Account";
  ViewData["Lead"] = "Create your NeoVimProject account.";
}

<div class="row justify-content-center">
  <div class="col-lg-8">
    <form method="post" class="form-card">
      <div asp-validation-summary="All" class="text-danger small mb-2"></div>
      <div class="row g-3">
        <div class="col-12"><label class="form-label" for="Username">Username</label><input class="form-control" id="Username" name="Username" type="text" placeholder="your_username" required /></div>
        <div class="col-md-6"><label class="form-label" for="Password">Password</label><input class="form-control" id="Password" name="Password" type="password" placeholder="" required /></div>
        <div class="col-md-6"><label class="form-label" for="ConfirmPassword">Confirm Password</label><input class="form-control" id="ConfirmPassword" name="ConfirmPassword" type="password" placeholder="" required /></div>
        <div class="col-md-6"><label class="form-label" for="FirstName">First Name</label><input class="form-control" id="FirstName" name="FirstName" type="text" placeholder="" required /></div>
        <div class="col-md-6"><label class="form-label" for="LastName">Last Name</label><input class="form-control" id="LastName" name="LastName" type="text" placeholder="" required /></div>
        <div class="col-md-6"><label class="form-label" for="City">City</label><input class="form-control" id="City" name="City" type="text" placeholder="" required /></div>
        <div class="col-md-6"><label class="form-label" for="Phone">Phone</label><input class="form-control" id="Phone" name="Phone" type="tel" placeholder="050-0000000" required /></div>
        <div class="col-md-6"><label class="form-label" for="Email">Email</label><input class="form-control" id="Email" name="Email" type="email" placeholder="you@@example.com" required /></div>
        <div class="col-md-6"><label class="form-label" for="BirthDate">Date of Birth</label><input class="form-control" id="BirthDate" name="BirthDate" type="date" placeholder="" required /></div>
        <div class="col-12">
          <label class="form-label d-block">Gender</label>
          <div class="form-check form-check-inline"><input class="form-check-input" type="radio" name="Gender" id="gM" value="Male" required /><label class="form-check-label" for="gM">Male</label></div>
          <div class="form-check form-check-inline"><input class="form-check-input" type="radio" name="Gender" id="gF" value="Female" /><label class="form-check-label" for="gF">Female</label></div>
          <div class="form-check form-check-inline"><input class="form-check-input" type="radio" name="Gender" id="gO" value="Other" /><label class="form-check-label" for="gO">Other</label></div>
        </div>
        <div class="col-md-6"><label class="form-label">Recovery question 1</label><select class="form-select" name="Question1" required>
          <option value="">Choose a question...</option>
          <option value="1">What was the name of your first pet?</option>
          <option value="2">What is your mother&#x27;s maiden name?</option>
          <option value="3">What city were you born in?</option>
          <option value="4">What was your first school?</option>
          <option value="5">What is your favourite editor?</option>
        </select></div>
        <div class="col-md-6"><label class="form-label">Answer 1</label><input class="form-control" name="Answer1" type="text" required /></div>
        <div class="col-md-6"><label class="form-label">Recovery question 2</label><select class="form-select" name="Question2" required>
          <option value="">Choose a question...</option>
          <option value="1">What was the name of your first pet?</option>
          <option value="2">What is your mother&#x27;s maiden name?</option>
          <option value="3">What city were you born in?</option>
          <option value="4">What was your first school?</option>
          <option value="5">What is your favourite editor?</option>
        </select></div>
        <div class="col-md-6"><label class="form-label">Answer 2</label><input class="form-control" name="Answer2" type="text" required /></div>
        <div class="col-12 d-flex gap-2">
          <button type="submit" class="btn btn-nv">Submit</button>
          <button type="reset" class="btn btn-nv-outline">Reset</button>
        </div>
      </div>
      <hr />
      <p class="mb-0">Already have an account? <a class="form-link" asp-page="/Login">Back to Login</a></p>
    </form>
  </div>
</div>
